{
  "name": "in-da-club",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:bez-kart": "npm run typograf:bez-kart && vite --config bez-kart/vite.config.ts",
    "dev:s-kartami": "npm run typograf:s-kartami && vite --config s-kartami/vite.config.ts",
    "build": "npm run build:bez-kart && npm run build:s-kartami",
    "build:bez-kart": "npm run typograf:bez-kart && tsc -p bez-kart/tsconfig.json && npm run build:bez-kart:new-client && npm run build:bez-kart:regular-1 && npm run build:bez-kart:regular-2 && npm run build:bez-kart:regular-3",
    "build:bez-kart:new-client": "vite build --config bez-kart/vite.config.ts --mode new-client",
    "build:bez-kart:regular-1": "vite build --config bez-kart/vite.config.ts --mode regular-1",
    "build:bez-kart:regular-2": "vite build --config bez-kart/vite.config.ts --mode regular-2",
    "build:bez-kart:regular-3": "vite build --config bez-kart/vite.config.ts --mode regular-3",
    "build:s-kartami": "npm run typograf:s-kartami && tsc -p s-kartami/tsconfig.json && npm run build:s-kartami:inactive && npm run build:s-kartami:one-trip && npm run build:s-kartami:two-trips && npm run build:s-kartami:three-plus",
    "build:s-kartami:inactive": "vite build --config s-kartami/vite.config.ts --mode inactive",
    "build:s-kartami:one-trip": "vite build --config s-kartami/vite.config.ts --mode one-trip",
    "build:s-kartami:two-trips": "vite build --config s-kartami/vite.config.ts --mode two-trips",
    "build:s-kartami:three-plus": "vite build --config s-kartami/vite.config.ts --mode three-plus",
    "typograf": "npm run typograf:bez-kart && npm run typograf:s-kartami",
    "typograf:bez-kart": "node scripts/typograf.mjs bez-kart/src",
    "typograf:s-kartami": "node scripts/typograf.mjs s-kartami/src",
    "typecheck": "tsc -p bez-kart/tsconfig.json && tsc -p s-kartami/tsconfig.json",
    "test": "npm run test:shared && npm run test:bez-kart && npm run test:s-kartami",
    "test:shared": "vitest run shared --environment jsdom",
    "test:bez-kart": "vitest run --config bez-kart/vitest.config.ts",
    "test:s-kartami": "vitest run --config s-kartami/vitest.config.ts",
    "preview:bez-kart": "vite preview --config bez-kart/vite.config.ts",
    "preview:s-kartami": "vite preview --config s-kartami/vite.config.ts"
  },
  "dependencies": {
    "petite-vue": "^0.4.1",
    "scroll-lock": "^2.1.5"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "sass": "^1.104.1",
    "typograf": "^7.8.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-monkey": "^8.1.1",
    "vitest": "^5.0.1"
  }
}
